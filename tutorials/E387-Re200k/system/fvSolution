FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
//  Steady SIMPLEC, matching the kOmegaSSTLM (LM) reference case, with the
//  gamma model's single transition field (gammaInt) added. Conservative 0.3
//  relaxation — required for a stable cold start on this E387 LSB mesh.
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        // GAMG: the pressure equation dominates cost on this mesh (PCG/DIC was
        // taking ~130 iterations per solve). Multigrid convergence is roughly
        // mesh-size independent, so this is the right choice here.
        solver           GAMG;
        smoother         DIC;
        tolerance        1e-08;
        relTol           0.001;
        cacheAgglomeration true;
        nCellsInCoarsestLevel 100;
        mergeLevels      1;
    }

    omega
    {
        solver          PBiCG;
        preconditioner  DILU;
        tolerance       1e-08;
        relTol          0;
    }

    "(U|k|gammaInt)"
    {
        solver          PBiCG;
        preconditioner  DILU;
        tolerance       1e-14;
        relTol          0.0001;
    }
}

SIMPLE
{
    nNonOrthogonalCorrectors 2;
    consistent          yes;

    // Stop as soon as it's steady. SST damps the LSB and usually converges by
    // ~4000 iters -> that converged field IS the answer (pMean == steady field).
    // If instead the LSB keeps oscillating, residuals plateau, this never trips,
    // the run reaches endTime, and fieldAverage (timeStart=5000) gives pMean.
    residualControl
    {
        p                1e-6;
        U                1e-6;
        "(k|omega|gammaInt)" 1e-6;
    }
}

relaxationFactors
{
    fields
    {
        p                0.3;
    }

    equations
    {
        U                0.3;
        k                0.3;
        omega            0.3;
        gammaInt         0.3;
    }
}

