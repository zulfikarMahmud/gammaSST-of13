FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include        "include/caseSettings"

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform $nutInlet;

boundaryField
{
    inlet
    {
        type            freestream;
        freestreamValue $internalField;
    }

    outlet
    {
        type            freestream;
        freestreamValue $internalField;
    }

    airfoil
    {
        type            nutLowReWallFunction;
        value           uniform 0;
    }

    sides
    {
        type            empty;
    }
}


