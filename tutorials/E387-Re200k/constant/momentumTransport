FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      momentumTransport;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

simulationType RAS;

RAS
{
    // Menter, Smirnov, Liu & Avancha (2015) one-equation gamma transition
    // model coupled to k-omega SST.  Supplied by the out-of-tree library
    // libgammaSST.so, loaded via the "libs" entry in system/controlDict.
    model           gammaSST;

    turbulence      on;
    printCoeffs     on;

    // Nothing is overridden: every gammaSST constant defaults to its published
    // 2015 value, and the inherited SST constants keep the standard SST-2003
    // values.  Add a gammaSSTCoeffs { ... } sub-dictionary only if you intend
    // to depart from the published model.
}


